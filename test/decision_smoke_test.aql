# Smoke test for the decision module. Imports the library and walks
# through every public word — a successful end-to-end run (no errors) is
# the pass condition. There are NO assertions here; the narrated output
# below just shows each word doing its job.
#
# Run:
#   aql test/decision_smoke_test.aql
#
# Style: every narrated line uses the forward `print (value)` form — the
# verb first, its one argument grouped in parens immediately after. Because
# that argument sits directly ahead of `print`, nothing reaches across a
# statement boundary, so NO `end`/`;` terminators are needed and the output
# still flushes in source order. (The stack form `(value) print` would need
# a terminator: `print` is forward-precedent, so without one it looks past
# the value behind it into the next statement and reverses the pair. The
# parens around each call are still required — `print Decision.foo a b`
# would print the *word* `foo` and strand `a b`; a `;` does not fix that.)

import "./decision.aql"

print "--- decision smoke demo ---"

# --- primitive operators (apply-op) --------------------------------
# apply-op takes rhs op lhs and computes `lhs op rhs`.
print "apply-op 25 gte 18:  "
print (Decision.apply-op 18 "gte" 25)         # lhs 25 gte rhs 18 => true
print "apply-op 'a' lt 'b':  "
print (Decision.apply-op "b" "lt" "a")        # lhs 'a' lt rhs 'b' => true
print "apply-op 5 is_not_null:"
print (Decision.apply-op 5 "is_not_null")     # unary => true

# --- a single condition (cond / eval-cond) -------------------------
def adult-cond (Decision.cond age/q "gte" 18)
print "cond record:          "
print adult-cond
print "eval-cond age 25:     "
print (Decision.eval-cond adult-cond {age:25}) # => true
print "eval-cond age 15:     "
print (Decision.eval-cond adult-cond {age:15}) # => false

# --- compound predicates (all-of / any-of / not-of / eval-pred) ----
def all-pred (Decision.all-of [
  {field:"age"   op:"gte" value:18}
  {field:"score" op:"gte" value:90}
])
print "eval-pred all-of:     "
print (Decision.eval-pred all-pred {age:25 score:95})   # => true

def any-pred (Decision.any-of [
  {field:"age"   op:"lt"  value:13}
  {field:"score" op:"gte" value:90}
])
print "eval-pred any-of:     "
print (Decision.eval-pred any-pred {age:25 score:95})   # => true (second child holds)

def not-pred (Decision.not-of {field:"age" op:"lt" value:18})
print "eval-pred not-of:     "
print (Decision.eval-pred not-pred {age:25})            # => true

# --- a decision table (make-rule / make-table / eval-table) --------
def rules [
  (Decision.make-rule {field:"age" op:"lt"  value:18} {category:"minor"})
  (Decision.make-rule {field:"age" op:"gte" value:65} {category:"senior"})
  (Decision.make-rule {field:"age" op:"gte" value:18} {category:"adult"})
]
def table (Decision.make-table rules)
print "eval-table age 12:    "
print (Decision.eval-table table {age:12})    # => {category: minor}
print "eval-table age 30:    "
print (Decision.eval-table table {age:30})    # => {category: adult}

# --- hit policies (with-policy) ------------------------------------
# collect returns a List of every matching rule's then.
def tag-rules [
  (Decision.make-rule {field:"age"   op:"gte" value:18} {tag:"adult"})
  (Decision.make-rule {field:"score" op:"gte" value:50} {tag:"passing"})
]
def collect-table (Decision.with-policy "collect" (Decision.make-table tag-rules))
print "with-policy collect:  "
print (Decision.eval-table collect-table {age:25 score:80})  # => [{tag: adult}, {tag: passing}]

# --- a decision tree (make-branch / make-leaf / make-tree / eval-tree)
def root-node (Decision.make-branch root/q [
  {when:{field:"age" op:"lt"  value:18} next:"minor"}
  {when:{field:"age" op:"gte" value:18} next:"adult"}
])
def minor-leaf (Decision.make-leaf minor/q "too-young")
def adult-leaf (Decision.make-leaf adult/q "welcome")
def tree (Decision.make-tree root/q [root-node minor-leaf adult-leaf])
print "eval-tree age 40:     "
print (Decision.eval-tree tree {age:40})      # => welcome
print "eval-tree age 10:     "
print (Decision.eval-tree tree {age:10})      # => too-young

# --- decide: dispatch on model kind --------------------------------
def senior-table (Decision.make-table rules)
print "decide table age 70:  "
print (Decision.decide senior-table {age:70}) # => {category: senior}
print "decide tree age 40:   "
print (Decision.decide tree {age:40})         # => welcome
def slim-table (Decision.make-table [
  (Decision.make-rule {field:"age" op:"lt"  value:18} {category:"minor"})
  (Decision.make-rule {field:"age" op:"gte" value:65} {category:"senior"})
])
print "decide no-match age 30:"
print (Decision.decide slim-table {age:30})   # => {ok: false, error: no-match}

print "--- decision smoke demo complete ---"
