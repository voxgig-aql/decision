# Smoke test for the decision module. Imports the library and walks
# through every public word — a successful end-to-end run (no errors) is
# the pass condition. There are NO assertions here; the narrated output
# below just shows each word doing its job.
#
# Run:
#   aql test/decision_smoke_test.aql
#
# Note: every line uses the `(value) print end` form — one value per
# statement — so the narrated output stays in source order (a bare
# leading `print …` collects forward and can reorder).

import "./decision.aql" end

("--- decision smoke demo ---") print end

# --- primitive operators (apply-op) --------------------------------
# apply-op takes rhs op lhs and computes `lhs op rhs`.
("apply-op 25 gte 18:  ") print end
((Decision.apply-op 18 "gte" 25)) print end         # lhs 25 gte rhs 18 => true
("apply-op 'a' lt 'b':  ") print end
((Decision.apply-op "b" "lt" "a")) print end        # lhs 'a' lt rhs 'b' => true
("apply-op 5 is_not_null:") print end
((Decision.apply-op 5 "is_not_null")) print end     # unary => true

# --- a single condition (cond / eval-cond) -------------------------
def adult-cond (Decision.cond age/q "gte" 18)
("cond record:          ") print end
((adult-cond)) print end
("eval-cond age 25:     ") print end
((Decision.eval-cond adult-cond {age:25})) print end # => true
("eval-cond age 15:     ") print end
((Decision.eval-cond adult-cond {age:15})) print end # => false

# --- compound predicates (all-of / any-of / not-of / eval-pred) ----
def all-pred (Decision.all-of [
  {field:"age"   op:"gte" value:18}
  {field:"score" op:"gte" value:90}
])
("eval-pred all-of:     ") print end
((Decision.eval-pred all-pred {age:25 score:95})) print end   # => true

def any-pred (Decision.any-of [
  {field:"age"   op:"lt"  value:13}
  {field:"score" op:"gte" value:90}
])
("eval-pred any-of:     ") print end
((Decision.eval-pred any-pred {age:25 score:95})) print end   # => true (second child holds)

def not-pred (Decision.not-of {field:"age" op:"lt" value:18})
("eval-pred not-of:     ") print end
((Decision.eval-pred not-pred {age:25})) print end            # => true

# --- a decision table (make-rule / make-table / eval-table) --------
def rules [
  (Decision.make-rule {field:"age" op:"lt"  value:18} {category:"minor"})
  (Decision.make-rule {field:"age" op:"gte" value:65} {category:"senior"})
  (Decision.make-rule {field:"age" op:"gte" value:18} {category:"adult"})
]
def table (Decision.make-table rules)
("eval-table age 12:    ") print end
((Decision.eval-table table {age:12})) print end    # => {category: minor}
("eval-table age 30:    ") print end
((Decision.eval-table table {age:30})) print end    # => {category: adult}

# --- hit policies (with-policy) ------------------------------------
# collect returns a List of every matching rule's then.
def tag-rules [
  (Decision.make-rule {field:"age"   op:"gte" value:18} {tag:"adult"})
  (Decision.make-rule {field:"score" op:"gte" value:50} {tag:"passing"})
]
def collect-table (Decision.with-policy "collect" (Decision.make-table tag-rules))
("with-policy collect:  ") print end
((Decision.eval-table collect-table {age:25 score:80})) print end  # => [{tag: adult}, {tag: passing}]

# --- a decision tree (make-branch / make-leaf / make-tree / eval-tree)
def root-node (Decision.make-branch root/q [
  {when:{field:"age" op:"lt"  value:18} next:"minor"}
  {when:{field:"age" op:"gte" value:18} next:"adult"}
])
def minor-leaf (Decision.make-leaf minor/q "too-young")
def adult-leaf (Decision.make-leaf adult/q "welcome")
def tree (Decision.make-tree root/q [root-node minor-leaf adult-leaf])
("eval-tree age 40:     ") print end
((Decision.eval-tree tree {age:40})) print end      # => welcome
("eval-tree age 10:     ") print end
((Decision.eval-tree tree {age:10})) print end      # => too-young

# --- decide: dispatch on model kind --------------------------------
def senior-table (Decision.make-table rules)
("decide table age 70:  ") print end
((Decision.decide senior-table {age:70})) print end # => {category: senior}
("decide tree age 40:   ") print end
((Decision.decide tree {age:40})) print end          # => welcome
def slim-table (Decision.make-table [
  (Decision.make-rule {field:"age" op:"lt"  value:18} {category:"minor"})
  (Decision.make-rule {field:"age" op:"gte" value:65} {category:"senior"})
])
("decide no-match age 30:") print end
((Decision.decide slim-table {age:30})) print end    # => {ok: false, error: no-match}

("--- decision smoke demo complete ---") print end
